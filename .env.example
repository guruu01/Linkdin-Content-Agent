# ========================================================
# AI Social Media Content Agent Configuration
# ========================================================

# --- LLM Providers (at least one recommended; fallback engine available) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=gemini  # gemini, groq, openai, or mock

# --- Agent Default Topics & Schedule ---
DEFAULT_TOPIC="AI and product management developments"
WORKFLOW_SCHEDULE_DAY=mon
WORKFLOW_SCHEDULE_TIME=09:00

# --- WhatsApp Review Integration (Twilio or wa.me direct) ---
# Twilio WhatsApp Sandbox / Production
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
RECIPIENT_WHATSAPP_NUMBER=whatsapp:+1234567890

# --- Notion Integration ---
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- Google Sheets Integration ---
# Path to service account credentials JSON file or leave empty for local Excel/CSV calendar export
GOOGLE_SERVICE_ACCOUNT_PATH=
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- LinkedIn API Publishing ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_ID_HERE
AUTO_PUBLISH_APPROVED=false

# --- App Server ---
APP_HOST=127.0.0.1
APP_PORT=8000

